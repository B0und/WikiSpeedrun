    "prettier-plugin-tailwindcss": "0.8.1",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "4.3.3",
    "tweakpane": "^4.0.5",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-ejs": "2.0.0",
    "vite-plugin-react-click-to-component": "4.2.3",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}