{
  "name": "wikispeedrun",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "cross-env LAUNCH_EDITOR=cursor vite --open",
    "dev:withMocks": "cross-env-shell VITE_WITH_MOCKS=true vite --open",
    "start": "vite --open",
    "viteBuild": "vite build",
    "build": "lingui extract --clean && nub run \"/^(typecheck|doctor|viteBuild)$/\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && git diff --exit-code -- src/locales",
    "format": "oxfmt src e2e",
    "format:check": "oxfmt --check src e2e",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "doctor": "react-doctor -y --no-score --blocking error",
    "test:browser": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@lingui/core": "6.7.0",
    "@lingui/detect-locale": "6.7.0",
    "@lingui/react": "6.7.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-portal": "1.1.17",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "2.1.1",
    "dompurify": "3.4.15",
    "immer": "11.1.18",
    "re-resizable": "6.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.5",
    "react-feather": "2.0.10",
    "react-hot-toast": "2.6.1",
    "react-select": "5.10.2",
    "tailwind-merge": "3.7.0",
    "unbound-zustand-querystring": "0.2.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@lingui/babel-plugin-lingui-macro": "6.7.0",
    "@lingui/cli": "6.7.0",
    "@lingui/vite-plugin": "6.7.0",
    "@nubjs/nub": "^0.9.2",
    "@rolldown/plugin-babel": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/router-plugin": "^1.168.40",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "3.2.0",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/ui": "5.0.1",
    "cross-env": "10.1.0",
    "ejs": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "msw": "2.15.0",
    "oxc-transform-react": "^0.150.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "react-doctor": "^0.9.14",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-ejs": "2.0.0",
    "vite-plugin-react-click-to-component": "4.2.3",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "@nubjs/nub": true
  }
}
