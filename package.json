{
  "name": "wikispeedrun",
  "private": true,
  "version": "0.0.0",
  "packageManager": "nub@0.9.2",
  "type": "module",
  "scripts": {
    "dev": "cross-env LAUNCH_EDITOR=cursor npm-run-all --parallel start typesafe-i18n",
    "dev:withMocks": "cross-env-shell VITE_WITH_MOCKS=true nub run dev",
    "start": "vite --open",
    "viteBuild": "vite build",
    "build": "npm-run-all --parallel typecheck lint viteBuild",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "typesafe-i18n": "typesafe-i18n",
    "format": "biome format --write ./src",
    "lint": "biome lint --fix && eslint --fix \"./src/**/*.{ts,tsx}\"",
    "test:browser": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-portal": "1.1.17",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-visually-hidden": "1.2.11",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "2.1.1",
    "dompurify": "3.4.15",
    "immer": "11.1.18",
    "re-resizable": "6.11.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.5",
    "react-feather": "2.0.10",
    "react-hot-toast": "2.6.1",
    "react-select": "5.10.2",
    "tailwind-merge": "3.7.0",
    "typesafe-i18n": "5.27.1",
    "unbound-zustand-querystring": "0.2.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@optimize-lodash/rollup-plugin": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/router-cli": "^1.167.38",
    "@tanstack/router-plugin": "^1.168.40",
    "@total-typescript/ts-reset": "0.6.1",
    "@tweakpane/core": "^2.0.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dompurify": "3.2.0",
    "@types/node": "^26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.1",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/ui": "5.0.1",
    "cross-env": "10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "msw": "2.15.0",
    "npm-run-all": "4.1.5",
    "playwright": "^1.63.0",
    "postcss": "8.5.28",
