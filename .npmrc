# Keep Nub's 24h cooling period to avoid installing newly published packages.
minimumReleaseAge=24h

# Match pnpm's default peer-dedup behavior so duplicated peer contexts
# (vitest <-> @vitest/ui circular peers) collapse into one instance.
dedupe-peer-dependents=true
auto-install-peers=true
resolve-peers-from-workspace-root=true

# npm's fallback install (e.g. Cloudflare build without nub) rejects the
# peerOptional range of @vitejs/plugin-react vs the newer oxc-transform-react.
legacy-peer-deps=true
